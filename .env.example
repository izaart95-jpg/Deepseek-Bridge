DEEPSEEK_TOKEN=eyk....
PROXY_API_KEY=Waguri
DEBUG=true
AGENT_MODE=true

# Async mode (default). Leave SYNC_MODE unset for the async flow; set it to
# true to restore the legacy synchronous per-request session flow.
#SYNC_MODE=false

# Standing batch of pre-made ready sessions used by async mode (history=false
# requests only).
#SESSION_POOL_SIZE=3

# Seconds a request waits for a pooled session during a burst before creating
# one directly. 0 waits forever.
#SESSION_ACQUIRE_TIMEOUT=10
